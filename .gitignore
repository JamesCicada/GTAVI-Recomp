# Build output
/build/
/out/
/install/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Visual Studio generator output. Generating into the source tree is always a
# mistake; these belong in the build directory. Ignored everywhere so a stray
# in-source configure can never be committed.
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.dir/
/generated/
*.VC.db
*.VC.VC.opendb

# Compiled objects and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.idb
*.exp
*.map

# IDE and editor state
.vs/
.vscode/
.idea/
.cache/
*.user
*.suo
*.swp
*~

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Local scratch space for research notes that must not be committed
/scratch/

# Built progress site (scripts/update_progress.py --site)
_site/

# Local virtual environment for the Discord bot (bot/README.md)
.venv-bot/
